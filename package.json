{
  "name": "shroff",
  "version": "0.1.0",
  "private": true,
  "description": "Delivery verification for x402 agent payments: Kane CLI verifies the delivery before the money settles",
  "license": "MIT",
  "author": "bomanaps",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "node --test --import tsx $(git ls-files '*.test.ts')",
    "demo": "tsx demo/judge-demo.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}